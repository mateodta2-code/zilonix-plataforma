# Railway la pone sola al conectar el servicio de Postgres. La usan
# `npm run db:migrate` y, a mano al rotar la clave de los tokens,
# `npm run tokens:recifrar` (docs/rotacion-claves.md). La app en
# tiempo real no: esa conexión es DATABASE_URL_APP (ver db/index.ts).
DATABASE_URL=

# Tarea 1.3 — el usuario de base restringido (app_user), el único que
# usa la app en tiempo real. Se crea a mano con db/rls-setup.sql (no es
# una migración, tiene una contraseña real adentro) y se arma la URL
# reemplazando usuario/contraseña en DATABASE_URL por los de app_user.
DATABASE_URL_APP=

# Tarea 1.5 — Clerk (decisión D3). Se sacan de dashboard.clerk.com →
# Configure → API keys, de la aplicación "Zilonix Plataforma". Pega
# SOLO el valor, nunca el bloque completo con el nombre de la otra
# variable al lado (bug real encontrado en vivo: las dos llaves quedaron
# pegadas en una sola variable y tumbaron el build).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Las rutas de login/registro propias (NEXT_PUBLIC_CLERK_SIGN_IN_URL y
# afines) NO van acá — son valores fijos, nunca cambian entre ambientes,
# así que están en next.config.mjs directamente.

# Claves de cifrado de los tokens de Mercado Libre (32 bytes en base64).
# Las crea una persona; este archivo solo deja el nombre. ML_TOKEN_KEY_ACTUAL
# es la versión con la que se cifran los tokens nuevos (si no está, vale 1).
# Ver docs/rotacion-claves.md.
ML_TOKEN_KEY_V1=
ML_TOKEN_KEY_V2=
ML_TOKEN_KEY_ACTUAL=
