# Railway la pone sola al conectar el servicio de Postgres — se usa
# SOLO para correr migraciones (npm run db:migrate), nunca para
# consultas de negocio (ver db/index.ts).
DATABASE_URL=

# Tarea 1.3 — el usuario de base restringido (app_user), el único que
# usa la app en tiempo real. Se crea a mano con db/rls-setup.sql (no es
# una migración, tiene una contraseña real adentro) y se arma la URL
# reemplazando usuario/contraseña en DATABASE_URL por los de app_user.
DATABASE_URL_APP=

# Tarea 1.11 — segundo usuario de base, aparte y más limitado: el panel
# superadmin nunca se conecta con app_user. Solo lectura de lo agregado.
DATABASE_URL_SUPERADMIN=

# Tarea 2.4 — tercer usuario de base, el más limitado de los tres: el
# trabajador de cola solo puede ver/actualizar avisos_ml.
DATABASE_URL_TRABAJADOR=

# Tarea 1.5 — Clerk (decisión D3). Se sacan de dashboard.clerk.com →
# Configure → API keys, de la aplicación "Zilonix Plataforma". Pega
# SOLO el valor, nunca el bloque completo con el nombre de la otra
# variable al lado (bug real encontrado en vivo: las dos llaves quedaron
# pegadas en una sola variable y tumbaron el build).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Las rutas de login/registro propias (NEXT_PUBLIC_CLERK_SIGN_IN_URL y
# afines) NO van acá — son valores fijos, nunca cambian entre ambientes,
# así que están en next.config.mjs directamente.

# Tarea 2.1/2.3 — app de Zilonix en Mercado Libre Developers (OAuth).
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Tarea 2.3 — clave de cifrado de los tokens de Mercado Libre (versión
# de clave, para poder rotarla sin perder acceso — ver lib/cifrado.ts).
# Se genera con `openssl rand -base64 32`, nunca a mano.
ML_TOKEN_KEY_V1=

# Tarea 2.4 — secreto compartido que valida al cron que llama a
# /api/ml/trabajador (cabecera x-trabajador-secret).
TRABAJADOR_SECRET=

# Issue #254 — usuario de base del cron de Product Ads. El nombre del
# rol es publicidad_trabajador_user. Lo crea Mateo después del merge,
# corriendo db/rls-setup.sql. Solo lista columnas no secretas de
# cuentas_ml y lee publicidad_sincronizaciones.
DATABASE_URL_PUBLICIDAD=

# Issue #254 — secreto del cron que llama a POST /api/trabajos/publicidad
# (cabecera x-publicidad-trabajador-secret). En GitHub Actions el de
# staging ya existe: PUBLICIDAD_TRABAJADOR_SECRET_STAGING. El de
# producción, cuando toque, es PUBLICIDAD_TRABAJADOR_SECRET_PRODUCCION.
# Nunca pegar el valor.
PUBLICIDAD_TRABAJADOR_SECRET=
