{
  "manifest_version": 3,
  "name": "Zilonix Seller — Investigación",
  "short_name": "Zilonix Investigación",
  "version": "0.3.37",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "description": "Lee precio, vendidos, vendedor y calificación de la página que estás viendo en Mercado Libre, Amazon, Temu, AliExpress, Shein y Alibaba — para analizar antes de invertir. Solo lee lo que ya tenés abierto; nunca navega sola ni inicia sesión.",
  "content_scripts": [
    {
      "matches": [
        "*://*.mercadolibre.com.co/*",
        "*://*.mercadolibre.com.ar/*",
        "*://*.mercadolivre.com.br/*",
        "*://*.mercadolibre.com.mx/*",
        "*://*.mercadolibre.cl/*",
        "*://*.mercadolibre.com.uy/*",
        "*://*.mercadolibre.com.pe/*"
      ],
      "js": [
        "utilidades.js",
        "seguridad.js",
        "config.js",
        "calibracion-aproximados.js",
        "lectores/aproximados.js",
        "lectores/mercadolibre.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.com.mx/*"
      ],
      "js": [
        "utilidades.js",
        "seguridad.js",
        "lectores/amazon.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.temu.com/*"
      ],
      "js": [
        "utilidades.js",
        "seguridad.js",
        "lectores/temu.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.aliexpress.com/*",
        "*://*.aliexpress.us/*"
      ],
      "js": [
        "utilidades.js",
        "seguridad.js",
        "lectores/aliexpress.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.shein.com/*",
        "*://*.shein.com.co/*"
      ],
      "js": [
        "utilidades.js",
        "seguridad.js",
        "lectores/shein.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.alibaba.com/*"
      ],
      "js": [
        "utilidades.js",
        "seguridad.js",
        "lectores/alibaba.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://web-production-af270.up.railway.app/panel/investigacion*",
        "*://web-staging-d979.up.railway.app/panel/investigacion*"
      ],
      "js": [
        "marcador-zilonix.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.css"
      ],
      "matches": [
        "*://*.mercadolibre.com.co/*",
        "*://*.mercadolibre.com.ar/*",
        "*://*.mercadolivre.com.br/*",
        "*://*.mercadolibre.com.mx/*",
        "*://*.mercadolibre.cl/*",
        "*://*.mercadolibre.com.uy/*",
        "*://*.mercadolibre.com.pe/*",
        "*://*.amazon.com/*",
        "*://*.amazon.com.mx/*",
        "*://*.temu.com/*",
        "*://*.aliexpress.com/*",
        "*://*.aliexpress.us/*",
        "*://*.shein.com/*",
        "*://*.shein.com.co/*",
        "*://*.alibaba.com/*"
      ]
    }
  ]
}
